name = "amd-api-proxy"
main = "src/worker.js"
compatibility_date = "2026-08-01"

# 自定义域绑定（可选）：把下面的地址换成你自己在 Cloudflare 托管的域名
# （zone 需在本 CF 账号内，CF 会自动创建 DNS 记录与证书）。
# 不配置 routes 时可使用默认的 workers.dev 域。
# 注意：真实 wrangler.toml 含你的私有域名，已列入 .gitignore，不入库。
routes = [
  { pattern = "<your-worker.your-domain.example>", custom_domain = true }
]
